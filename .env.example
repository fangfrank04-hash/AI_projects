# AiProctor 智能监考服务配置模板
# 使用方法：复制为 .env，按需修改，重启服务后生效。
# 优先级：系统环境变量 / Docker environment > .env > 代码默认值。

# ===== 服务配置 =====
APP_NAME=AiProctor 智能监考
APP_DESCRIPTION=AI智能体中心API服务
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
# DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# ===== 人脸角度阈值 =====
MAX_LEFT_ANGLE=6
MAX_RIGHT_ANGLE=-6
MAX_UP_ANGLE=6
MAX_DOWN_ANGLE=-1

# ===== 打电话 =====
# 腕耳归一化距离小于该值，并满足手臂弯曲条件时告警。
PHONE_WRIST_EAR_DIST=0.55
PHONE_ARM_ANGLE=30

# ===== 伸胳膊 =====
STRETCH_ARM_ANGLE=140
HORIZONTAL_STRETCH_ARM_ANGLE=155
HORIZONTAL_STRETCH_VISIBILITY=0.4
HORIZONTAL_STRETCH_ARM_LENGTH=1.05
HORIZONTAL_STRETCH_WRIST_EAR_DIST=1.6
ELBOW_STRETCH_VISIBILITY=0.25
ELBOW_STRETCH_MAX_DY=0.5
ELBOW_STRETCH_MIN_REACH=0.7

# ===== 转身与通用关键点 =====
TURN_BODY_SHOULDER_DIST=0.25
VISIBILITY_THRESHOLD=0.5

# ===== 多人姿态兜底 =====
MULTI_PERSON_POSE_CONFIDENCE=0.2
MULTI_PERSON_MAX_POSES=3
MULTI_PERSON_MIN_SEPARATION=0.15

# ===== 并发模型池 =====
PROCTOR_POOL_SIZE=2
