# AiProctor 智能监考服务配置模板
# 使用方法：复制本文件为 .env，按需修改参数值
#   cp .env.example .env
# 改配置后重启服务即可生效，不用动代码

# ===== 服务配置 =====
APP_NAME=AiProctor 智能监考
APP_DESCRIPTION=AI智能体中心API服务
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000

# ===== 人脸角度阈值 =====
# 正常范围为 -6 到 6（左右），-1 到 6（上下）
# 超出范围则判定为"视线离开屏幕"
MAX_LEFT_ANGLE=6
MAX_RIGHT_ANGLE=-6
MAX_UP_ANGLE=6
MAX_DOWN_ANGLE=-1

# ===== Pose 动作检测阈值 =====
# 这些值基于 14 张真实样本标定（2026-07-01），一般不用改
# 打电话：腕耳归一化距离 < 0.35 且 y 坐标差 < 0.25
PHONE_WRIST_EAR_DIST=0.35
PHONE_WRIST_EAR_Y_DIFF=0.25
# 站立：躯干纵向高度 > 1.20，双肩距 > 0.48，肩部 y < 0.5
STAND_TORSO_HEIGHT=1.20
STAND_SHOULDER_DIST=0.48
STAND_SHOULDER_Y=0.5
# 伸展：肩-肘-腕夹角 > 150°
STRETCH_ARM_ANGLE=150
# 转身90度：双肩归一化距离 < 0.25
TURN_BODY_SHOULDER_DIST=0.25
# 关键点 visibility 过滤阈值
VISIBILITY_THRESHOLD=0.5
